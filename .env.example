# Copy this file to .env and fill in real values before going live.

# REQUIRED IN PRODUCTION.
# Used to sign admin session cookies. Generate one with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value logs every admin out immediately.
SESSION_SECRET=

# Public URL of the site, used for share links, sitemap and SEO tags.
NEXT_PUBLIC_SITE_URL=https://riseupmanpower.com

# Set this only if you serve the site over HTTPS and your reverse proxy does
# NOT send the x-forwarded-proto header. Leave it unset otherwise: the session
# cookie then follows how the request actually arrived, which is what lets the
# admin panel work over a LAN address, a Tailscale IP or a domain as well as
# on localhost.
#   true  = always mark the session cookie Secure (HTTPS only)
#   false = never mark it Secure
# SESSION_COOKIE_SECURE=true

# Where the SQLite database file lives. Defaults to ./data/riseup.db
# DATABASE_PATH=./data/riseup.db

# Where uploaded files are stored. Defaults to ./data/uploads
# UPLOAD_DIR=./data/uploads

# First super-admin created by `npm run seed`.
# CHANGE THE PASSWORD IMMEDIATELY AFTER THE FIRST LOGIN.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe@2026
SEED_ADMIN_EMAIL=admin@riseupmanpower.com

# Git repository the update system pulls from.
UPDATE_REPO_URL=
UPDATE_BRANCH=main

# How many timestamped backups to keep before the oldest is pruned.
BACKUP_RETENTION=10
